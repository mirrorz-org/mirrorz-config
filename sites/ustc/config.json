{
  "abbrs": [
    "USTC"
  ],
  "endpoints": [
    {
      "label": "ustc",
      "public": true,
      "resolve": "mirrors.ustc.edu.cn",
      "filter": [
        "V4",
        "V6",
        "SSL",
        "NOSSL"
      ],
      "range": [
        "COUNTRY:CN",
        "REGION:AH"
      ]
    },
    {
      "label": "ustc6",
      "public": true,
      "resolve": "ipv6.mirrors.ustc.edu.cn",
      "filter": [
        "V6",
        "SSL",
        "NOSSL"
      ],
      "range": [
        "COUNTRY:CN",
        "REGION:AH",
        "ISP:CERNET"
      ]
    },
    {
      "label": "ustc4",
      "public": true,
      "resolve": "ipv4.mirrors.ustc.edu.cn",
      "filter": [
        "V4",
        "SSL",
        "NOSSL"
      ],
      "range": [
        "COUNTRY:CN",
        "REGION:AH"
      ]
    },
    {
      "label": "ustcchinanet",
      "public": true,
      "resolve": "chinanet.mirrors.ustc.edu.cn",
      "filter": [
        "V4",
        "SSL",
        "NOSSL"
      ],
      "range": [
        "COUNTRY:CN",
        "REGION:AH",
        "ISP:CHINANET"
      ]
    },
    {
      "label": "ustccernet",
      "public": true,
      "resolve": "cernet.mirrors.ustc.edu.cn",
      "filter": [
        "V4",
        "V6",
        "SSL",
        "NOSSL"
      ],
      "range": [
        "COUNTRY:CN",
        "REGION:AH",
        "ISP:CERNET"
      ]
    },
    {
      "label": "ustcunicom",
      "public": true,
      "resolve": "unicom.mirrors.ustc.edu.cn",
      "filter": [
        "V4",
        "SSL",
        "NOSSL"
      ],
      "range": [
        "COUNTRY:CN",
        "REGION:AH",
        "ISP:UNICOM"
      ]
    },
    {
      "label": "ustccmcc",
      "public": true,
      "resolve": "cmcc.mirrors.ustc.edu.cn",
      "filter": [
        "V4",
        "SSL",
        "NOSSL"
      ],
      "range": [
        "COUNTRY:CN",
        "REGION:AH",
        "ISP:CMCC"
      ]
    }
  ],
  "redirects": {
    "raspberrypi": {
      "rewrite": [
        {
          "match": "^/(.*)$",
          "target": "/debian/${1}"
        }
      ]
    },
    "Adoptium": {
      "rewrite": [
        {
          "match": "^/(\\d+)/(?:jdk|jre)/(?:[^/]+/)+(.+)$",
          "target": "/releases/temurin$1-binaries/LatestRelease/$2"
        },
        {
          "match": "^/rpm/(centos|fedora)(\\d+)-([^/]+)/(.+)$",
          "target": "/rpm/$1/$2/$3/$4"
        },
        {
          "match": "^/rpm/(rhel)(\\d+)-([^/]+)/(.+)$",
          "target": "/rpm/centos/$2/$3/$4"
        }
      ]
    }
  },
  "mirrorlist_paths": {
    "raspberrypi": "/raspberrypi/debian"
  }
}

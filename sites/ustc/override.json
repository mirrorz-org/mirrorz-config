{
  "mirrors": [
    {
      "cname": "raspberrypi",
      "url": "/raspberrypi/debian",
      "mirrorlist_paths": "/raspberrypi/debian",
      "rules": [
        {
          "normalize": {
            "type": "path",
            "match": "^/raspberrypi/debian",
            "target": "/raspberrypi"
          }
        }
      ]
    },
    {
      "cname": "Adoptium",
      "rules": [
        {
          "type": "regex",
          "match": "^/(\\d+)/(?:jdk|jre)/(?:[^/]+/)+(.+)$",
          "target": "/releases/temurin$1-binaries/LatestRelease/$2",
          "normalize": {
            "type": "regex",
            "match": "^/adoptium/releases/temurin([0-9]+)-binaries/LatestRelease/(OpenJDK[0-9]+U-(jdk|jre)_([^_]+)_([^_]+)_.+)$",
            "target": "/Adoptium/${1}/${3}/${4}/${5}/${2}"
          }
        },
        {
          "type": "regex",
          "match": "^/rpm/(centos|fedora)(\\d+)-([^/]+)/(.+)$",
          "target": "/rpm/$1/$2/$3/$4",
          "normalize": {
            "type": "regex",
            "match": "^/adoptium/rpm/(centos|fedora)/([0-9]+)/([^/]+)(/.*)$",
            "target": "/Adoptium/rpm/${1}${2}-${3}${4}"
          }
        },
        {
          "type": "regex",
          "match": "^/rpm/(rhel)(\\d+)-([^/]+)/(.+)$",
          "target": "/rpm/centos/$2/$3/$4"
        }
      ]
    }
  ]
}
